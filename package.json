{
  "name": "taskforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "esbuild apps/api/src/server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.mjs && esbuild scripts/migrate.ts scripts/bootstrap.ts scripts/create-project.ts scripts/rotate-token.ts scripts/retention.ts --bundle --platform=node --packages=external --format=esm --outdir=dist --out-extension:.js=.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "project:create": "tsx scripts/create-project.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
